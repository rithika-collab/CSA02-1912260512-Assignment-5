ALGORITHM SAVE_DONORS

START

OPEN donor file in write mode

IF file opening fails THEN
    DISPLAY "Unable to open donor file"
    RETURN FAILURE
END IF

FOR each donor record
    WRITE donor details into file
END FOR

CLOSE file

RETURN SUCCESS

END

ALGORITHM LOAD_DONORS

START

OPEN donor file in read mode

IF file opening fails THEN
    RETURN FAILURE
END IF

WHILE another donor record is available
    READ donor details
    ADD donor to donorRecords
END WHILE

CLOSE file

RETURN SUCCESS

END
