ALGORITHM SUM_DIGITS(n)

START

IF n < 10 THEN
    RETURN n
END IF

RETURN (n MOD 10) + SUM_DIGITS(n DIV 10)

END

DIGITAL ROOTS:

ALGORITHM DIGITAL_ROOT(n)

START

IF n < 10 THEN
    RETURN n
END IF

sum = SUM_DIGITS(n)

RETURN DIGITAL_ROOT(sum)

END

LINEAR POWER:

ALGORITHM POWER_LINEAR(base, n)

START

IF n = 0 THEN
    RETURN 1
END IF

RETURN base * POWER_LINEAR(base, n - 1)

END

POWER USING HALVING RECURSION:

ALGORITHM POWER_HALVING(base, n)

START

IF n = 0 THEN
    RETURN 1
END IF

IF n = 1 THEN
    RETURN base
END IF

half = POWER_HALVING(base, n DIV 2)

IF n MOD 2 = 0 THEN
    RETURN half * half
ELSE
    RETURN base * half * half
END IF

END
